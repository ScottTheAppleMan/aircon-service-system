# Copy to frontend/.env and adjust. Vite only exposes VITE_-prefixed values.

# Where the Express backend is listening (backend/src/server.js uses 5000).
VITE_API_BASE_URL=http://localhost:5000

# true  -> login runs on the dummy accounts in src/api/mockAuthApi.js
# false -> login calls the real /api/auth endpoints
# Flip this to false once the Azure SQL database is connected.
VITE_USE_MOCK_AUTH=true
